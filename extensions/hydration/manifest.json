{
  "id": "hydration",
  "type": "widget",
  "name": "Hydration",
  "description": "Water intake tracker with reminders",
  "offNote": "Off — also stops the reminders and the tracking",
  "icon": "water_drop",
  "version": "0.1.2",
  "apiVersion": 1,
  "contributes": {
    "service": "Service.qml",
    "widgets": [
      {
        "id": "hydration",
        "component": "Widget.qml"
      }
    ],
    "settings": "Settings.qml",
    "commands": [
      {
        "name": "show",
        "description": "Show the reminder now"
      },
      {
        "name": "add",
        "description": "Log water: add <ml>"
      },
      {
        "name": "status",
        "description": "What has been drunk today and the goal"
      }
    ]
  },
  "requires": {
    "sylphrena": ">=0.5.2"
  },
  "data": [
    "state:hydration.json"
  ]
}
